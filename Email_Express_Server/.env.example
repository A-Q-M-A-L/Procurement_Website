PORT=3001
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@frontierprojects.net
SMTP_PASS=replace-with-smtp-password
MAIL_TO=contact@frontierprojects.net
MAIL_FROM=Frontier Projects <contact@frontierprojects.net>
# Include every browser origin that will call /quote (comma-separated).
# Docker compose publishes the site at http://localhost:8080 by default.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://frontierprojects.net,https://www.frontierprojects.net
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5
READINESS_VERIFY_TIMEOUT_MS=5000
# docker-compose sets TRUST_PROXY=true; use true whenever nginx/LB sits in front
TRUST_PROXY=false
