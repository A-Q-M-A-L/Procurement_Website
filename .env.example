# Public site config (safe to expose — baked into the static build)
NUXT_PUBLIC_SITE_URL=https://frontierprojects.net
NUXT_PUBLIC_COMPANY_NAME=Frontier Projects
NUXT_PUBLIC_CONTACT_EMAIL=contact@frontierprojects.net
NUXT_PUBLIC_PHONE=+923359571564

# Quote API base URL:
# - Local `npm run dev` (API on :3001): http://localhost:3001
# - Docker / same-origin nginx proxy: leave empty so the form posts to /quote
NUXT_PUBLIC_API_URL=http://localhost:3001

# Optional overrides (defaults also live in nuxt.config.ts)
# NUXT_PUBLIC_WHATSAPP_NUMBER=923055443110
# NUXT_PUBLIC_WHATSAPP_MESSAGE=Hi, I'd like a quote for...
# NUXT_PUBLIC_OFFICE_ADDRESS=Blue Area, Islamabad, Pakistan
# NUXT_PUBLIC_MAP_EMBED_URL=https://maps.google.com/maps?q=Blue%20Area%2C%20Islamabad%2C%20Pakistan&z=14&output=embed
# NUXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61593094692015
# NUXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/frontier.projects/
# NUXT_PUBLIC_SOCIAL_TIKTOK=https://www.tiktok.com/@frontierprojects
